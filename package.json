{
  "name": "agrodata",
  "version": "1.0.0",
  "private": true,
  "description": "AgroData - Sistema de gestión cooperativa agrícola (monorepo)",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean",
    "db:migrate": "npm run db:migrate -w @agrodata/database",
    "db:migrate:prod": "npm run db:migrate:prod -w @agrodata/database",
    "db:generate": "turbo db:generate",
    "db:seed": "turbo db:seed",
    "db:studio": "npm run db:studio -w @agrodata/database",
    "db:reset": "npm run db:reset -w @agrodata/database",
    "db:push": "turbo db:push"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "turbo": "^2.5.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true
  }
}
