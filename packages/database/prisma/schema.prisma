generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────

enum Rol {
  ADMIN
  USER
}

enum RolSic {
  RESPONSABLE_SIC
  INSPECTOR
  COMITE_DECISION
  TECNICO_CAMPO
  ACOPIADOR
  CAPACITADOR
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  CONVIVIENTE
  VIUDO
}

enum NivelEducativo {
  SIN_ESTUDIOS
  PRIMARIA
  SECUNDARIA
  TECNICO
  UNIVERSITARIO
}

enum Idioma {
  QUECHUA
  ESPANOL
  OTRO
  NINGUNO
}

enum EstadoProductor {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum CargoProductor {
  SOCIO
  DIRECTIVO
  PRESIDENTE
  VICEPRESIDENTE
  SECRETARIO
  TESORERO
  VOCAL
  OTRO
}

enum CertificacionParcela {
  ORGANICA
  EN_TRANSICION
  CONVENCIONAL
}

enum EstadoParcela {
  ACTIVA
  INACTIVA
}

enum EstadoCultivo {
  ACTIVO
  EN_DESARROLLO
  COSECHADO
  FINALIZADO
}

enum MetodoSiembra {
  DIRECTA
  TRASPLANTE
  ALMACIGO
  OTRO
}

enum SistemaProductivo {
  AGROECOLOGICO
  ORGANICO
  CONVENCIONAL
  EN_TRANSICION
}

enum TipoAgricultura {
  TRADICIONAL
  TECNIFICADA
  MIXTA
}

enum CertificacionCultivo {
  ORGANICA
  EN_TRANSICION
  SIN_CERTIFICAR
}

enum ProcedenciaSemilla {
  CERTIFICADA
  COMUN
  PRODUCIDA_EN_CAMPO
  CONSERVADA_POR_AGRICULTOR
}

enum DestinoProduccion {
  VENTA_COOPERATIVA
  COMERCIALIZACION_LOCAL
  AUTOCONSUMO
  SEMILLA
}

enum EstadoCampania {
  PLANIFICADA
  ACTIVA
  FINALIZADA
  CANCELADA
}

enum TipoActividad {
  PREPARACION_TERRENO
  SIEMBRA
  RESIEMBRA
  FERTILIZACION
  COMPOSTAJE
  APLICACION_BIOLES
  CONTROL_BIOLOGICO
  MANEJO_PLAGAS
  MANEJO_ENFERMEDADES
  DESHIERBIE
  RIEGO
  PODA
  APORQUE
  COSECHA
  OTRA
}

enum PrioridadActividad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoActividad {
  PROGRAMADA
  EN_PROCESO
  COMPLETADA
}

enum CategoriaDocumento {
  PERSONAL
  INSTITUCIONAL
  OTROS
}

enum EstadoDocumento {
  PENDIENTE
  VERIFICADO
  RECHAZADO
}

enum EstadoAcopio {
  EN_PROCESO
  COMPLETADO
  EN_PLANTA
}

enum EstadoProducto {
  EXCELENTE
  BUENO
  REGULAR
  RECHAZADO
}

enum EstadoInspeccion {
  PENDIENTE
  APROBADA
  NO_CONFORME
}

enum ResultadoInspeccion {
  CONFORME
  CONFORME_CON_OBSERVACIONES
  NO_CONFORME
}

enum CumplimientoCriterio {
  CUMPLE
  NO_CUMPLE
  NO_APLICA
}

enum RiesgoNivel {
  BAJO
  MEDIO
  ALTO
}

enum SeveridadNoConformidad {
  LEVE
  MODERADA
  CRITICA
}

enum EstadoNoConformidad {
  PENDIENTE
  EN_PROCESO
  CORREGIDA
  VERIFICADA
}

enum EstadoAccionCorrectiva {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  VERIFICADA
}

enum EstadoRecepcion {
  PENDIENTE_PESAJE
  EN_CONTROL_CALIDAD
  DISPONIBLE
  RECHAZADA
}

enum CategoriaRecepcion {
  PRIMERA
  SEGUNDA
  INDUSTRIAL
  DESCARTE
}

enum DestinoRecepcion {
  PROCESAMIENTO
  ALMACEN_TEMPORAL
  RECHAZADO
}

enum ResultadoRecepcion {
  ACEPTADO
  ACEPTADO_CON_OBSERVACIONES
  RECHAZADO
}

enum EstadoProcesamiento {
  REGISTRADA
  EN_PROCESO
  COMPLETADA
  PAUSADA
  CANCELADA
}

enum LineaProcesamiento {
  GRANOS
  TUBERCULOS
  LEGUMBRES
  SEMILLAS
}

enum CalidadProducto {
  PRIMERA
  SEGUNDA
  TERCERA
  DESCARTE
}

enum EstadoKardex {
  DISPONIBLE
  RESERVADO
  CONSUMIDO
  VENCIDO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  TRANSFERENCIA
  AJUSTE
}

// ─── Models ───────────────────────────────────────────────

model Productor {
  id                 Int             @id @default(autoincrement())
  codigo             String          @unique @db.VarChar(20)
  dni                String          @unique @db.VarChar(8)
  nombres            String          @db.VarChar(100)
  apellido_paterno   String          @db.VarChar(100)
  apellido_materno   String          @db.VarChar(100)
  sexo               Sexo
  fecha_nacimiento   DateTime        @db.DateTime(3)
  estado_civil       EstadoCivil
  telefono           String?         @db.VarChar(20)
  correo             String?         @db.VarChar(150)
  departamento       String          @db.VarChar(100)
  provincia          String          @db.VarChar(100)
  distrito           String          @db.VarChar(100)
  comunidad          String          @db.VarChar(150)
  direccion          String?         @db.Text
  nivel_educativo    NivelEducativo
  idioma_principal   Idioma
  idioma_secundario  Idioma          @default(NINGUNO)
  material_vivienda  String?         @db.VarChar(50)
  acceso_agua        String?         @db.VarChar(10)
  acceso_energia     String?         @db.VarChar(10)
  acceso_internet    String?         @db.VarChar(10)
  seguro_salud       String?         @db.VarChar(50)
  acceso_credito     String?         @db.VarChar(10)
  servicio_sanitario String?         @db.VarChar(50)
  estado             EstadoProductor @default(ACTIVO)
  fecha_ingreso      DateTime        @db.DateTime(3)
  organizacion       String          @db.VarChar(200)
  cargo              CargoProductor
  foto_url           String?         @db.VarChar(500)
  firma_url          String?         @db.VarChar(500)
  created_at         DateTime        @default(now()) @db.DateTime(3)
  updated_at         DateTime        @updatedAt @db.DateTime(3)
  activo             Boolean         @default(true)
  created_by         String?         @db.VarChar(36)
  updated_by         String?         @db.VarChar(36)

  familiares        familiar[]
  documentos        documentos[]
  parcelas          parcela[]
  acopio_detalles   acopio_detalle[]
}

model familiar {
  id                 Int      @id @default(autoincrement())
  nombres            String   @db.VarChar(200)
  parentesco         String   @db.VarChar(50)
  dni                String?  @db.VarChar(8)
  sexo               Sexo
  fecha_nacimiento   DateTime @db.DateTime(3)
  ocupacion          String?  @db.VarChar(100)
  nivel_educativo    NivelEducativo?
  telefono           String?  @db.VarChar(20)
  dependiente        Boolean  @default(false)
  vive_con_productor Boolean  @default(true)
  created_at         DateTime @default(now()) @db.DateTime(3)
  updated_at         DateTime @updatedAt @db.DateTime(3)
  productor_id       Int

  productor Productor @relation(fields: [productor_id], references: [id])

  @@index([productor_id])
}

model documentos {
  id             Int                @id @default(autoincrement())
  tipo           String             @db.VarChar(100)
  categoria      CategoriaDocumento
  nombre_archivo String             @db.VarChar(255)
  ruta_archivo   String             @db.VarChar(500)
  tamano_bytes   Int
  mime_type      String             @db.VarChar(100)
  estado         EstadoDocumento    @default(PENDIENTE)
  created_at     DateTime           @default(now()) @db.DateTime(3)
  updated_at     DateTime           @updatedAt @db.DateTime(3)
  productor_id   Int

  productor Productor @relation(fields: [productor_id], references: [id])

  @@index([productor_id])
}

model parcela {
  id                  Int                  @id @default(autoincrement())
  codigo              String               @unique @db.VarChar(20)
  nombre              String               @db.VarChar(200)
  cultivo             String               @db.VarChar(100)
  area                Decimal              @db.Decimal(10, 2)
  area_certificada    Decimal?             @db.Decimal(10, 2)
  area_unidad         String               @default("ha") @db.VarChar(10)
  ubicacion           String?              @db.VarChar(200)
  certificacion       CertificacionParcela @default(CONVENCIONAL)
  estado              EstadoParcela        @default(ACTIVA)
  comunidad           String?              @db.VarChar(150)
  sector              String?              @db.VarChar(150)
  altitud             String?              @db.VarChar(50)
  departamento        String?              @db.VarChar(100)
  provincia           String?              @db.VarChar(100)
  distrito            String?              @db.VarChar(100)
  centro_poblado      String?              @db.VarChar(150)
  ubigeo              String?              @db.VarChar(6)
  latitud             String?              @db.VarChar(30)
  longitud            String?              @db.VarChar(30)
  precision_gps       String?              @db.VarChar(20)
  tipo_suelo          String?              @db.VarChar(100)
  textura             String?              @db.VarChar(50)
  pendiente           String?              @db.VarChar(100)
  fuente_agua         String?              @db.VarChar(100)
  sistema_riego       String?              @db.VarChar(100)
  zona_agroecologica  String?              @db.VarChar(100)
  disponibilidad_agua String?              @db.VarChar(50)
  observaciones       String?              @db.Text
  area_calculada      String?              @db.VarChar(50)
  perimetro           String?              @db.VarChar(50)
  vertices            Int?
  poligono            String?              @db.Text
  fecha_levantamiento DateTime?            @db.DateTime(3)
  responsable         String?              @db.VarChar(150)
  activo              Boolean              @default(true)
  created_at          DateTime             @default(now()) @db.DateTime(3)
  updated_at          DateTime             @updatedAt @db.DateTime(3)
  created_by          String?              @db.VarChar(36)
  updated_by          String?              @db.VarChar(36)
  acreditacion        String?              @db.VarChar(50)
  utm_este            String?              @db.VarChar(20)
  utm_norte           String?              @db.VarChar(20)
  utm_zona            String?              @db.VarChar(10)
  productores_id      Int

  productor   Productor           @relation(fields: [productores_id], references: [id])
  documentos  parcela_documentos[]
  fotos       parcela_fotos[]
  cultivos    cultivo[]

  @@index([productores_id])
}

model parcela_documentos {
  id             Int      @id @default(autoincrement())
  tipo           String   @db.VarChar(100)
  nombre_archivo String   @db.VarChar(255)
  ruta_archivo   String   @db.VarChar(500)
  tamano_bytes   Int
  mime_type      String   @db.VarChar(100)
  estado         String   @default("PENDIENTE") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.DateTime(3)
  updated_at     DateTime @updatedAt @db.DateTime(3)
  parcela_id     Int

  parcela parcela @relation(fields: [parcela_id], references: [id])
}

model parcela_fotos {
  id            Int       @id @default(autoincrement())
  titulo        String    @db.VarChar(150)
  descripcion   String?   @db.VarChar(500)
  fecha         DateTime? @db.DateTime(3)
  autor         String?   @db.VarChar(150)
  observaciones String?   @db.Text
  ruta_archivo  String?   @db.VarChar(500)
  created_at    DateTime  @default(now()) @db.DateTime(3)
  updated_at    DateTime  @updatedAt @db.DateTime(3)
  parcela_id    Int

  parcela parcela @relation(fields: [parcela_id], references: [id])
}

model campanias {
  id                     Int            @id @default(autoincrement())
  codigo                 String         @unique @db.VarChar(20)
  nombre                 String         @db.VarChar(200)
  anio_agricola          String         @db.VarChar(10)
  fecha_inicio           DateTime       @db.DateTime(3)
  fecha_fin              DateTime       @db.DateTime(3)
  descripcion            String?        @db.Text
  estado                 EstadoCampania @default(PLANIFICADA)
  responsable            String         @db.VarChar(150)
  tecnico_coordinador    String         @db.VarChar(150)
  objetivo               String?        @db.Text
  permitir_cultivos      Boolean        @default(true)
  permitir_actividades   Boolean        @default(true)
  permitir_cosechas      Boolean        @default(true)
  permitir_inspecciones  Boolean        @default(true)
  permitir_acopio        Boolean        @default(true)
  permitir_procesamiento Boolean        @default(true)
  visible                Boolean        @default(true)
  activa                 Boolean        @default(false)
  observaciones          String?        @db.Text
  activo                 Boolean        @default(true)
  created_at             DateTime       @default(now()) @db.DateTime(3)
  updated_at             DateTime       @updatedAt @db.DateTime(3)
  created_by             String?        @db.VarChar(36)
  updated_by             String?        @db.VarChar(36)

  cultivos cultivo[]
}

model cultivo {
  id                      Int                   @id @default(autoincrement())
  codigo                  String                @unique @db.VarChar(20)
  cultivo                 String                @db.VarChar(100)
  variedad                String?               @db.VarChar(100)
  area_sembrada           Decimal?              @db.Decimal(10, 2)
  fecha_siembra           DateTime?             @db.DateTime(3)
  metodo_siembra          MetodoSiembra?
  sistema_productivo      SistemaProductivo?
  tipo_agricultura        TipoAgricultura?
  certificacion           CertificacionCultivo? @default(SIN_CERTIFICAR)
  procedencia_semilla     ProcedenciaSemilla?
  cantidad_semilla        Decimal?              @db.Decimal(10, 2)
  unidad_semilla          String?               @db.VarChar(10)
  fecha_cosecha           DateTime?             @db.DateTime(3)
  estado                  EstadoCultivo         @default(ACTIVO)
  observaciones           String?               @db.Text
  rendimiento_esperado    Decimal?              @db.Decimal(10, 2)
  produccion_estimada     Decimal?              @db.Decimal(10, 2)
  destino_produccion      DestinoProduccion?
  distanciamiento_surcos  String?               @db.VarChar(50)
  distanciamiento_plantas String?               @db.VarChar(50)
  densidad_siembra        String?               @db.VarChar(50)
  tipo_semilla            String?               @db.VarChar(100)
  lote_semilla            String?               @db.VarChar(100)
  proveedor_semilla       String?               @db.VarChar(150)
  activo                  Boolean               @default(true)
  created_at              DateTime              @default(now()) @db.DateTime(3)
  updated_at              DateTime              @updatedAt @db.DateTime(3)
  created_by              String?               @db.VarChar(36)
  updated_by              String?               @db.VarChar(36)
  parcela_id              Int
  campanias_id            Int

  parcela      parcela          @relation(fields: [parcela_id], references: [id])
  campania     campanias        @relation(fields: [campanias_id], references: [id])
  actividades  actividades[]
  inspecciones Inspecciones[]
  acopios_detalles acopio_detalle[]
}

model actividades {
  id                     Int               @id @default(autoincrement())
  codigo                 String            @unique @db.VarChar(20)
  fecha                  DateTime          @db.DateTime(3)
  tipo_actividad         TipoActividad
  descripcion            String?           @db.Text
  responsable_tecnico    String            @db.VarChar(150)
  hora_inicio            String?           @db.VarChar(5)
  hora_fin               String?           @db.VarChar(5)
  duracion_estimada      String?           @db.VarChar(50)
  prioridad              PrioridadActividad @default(MEDIA)
  estado                 EstadoActividad   @default(PROGRAMADA)
  jornales               Int?              @default(0)
  latitud                String?           @db.VarChar(30)
  longitud               String?           @db.VarChar(30)
  altitud                String?           @db.VarChar(50)
  precision_gps          String?           @db.VarChar(20)
  observaciones_tecnicas String?           @db.Text
  recomendaciones        String?           @db.Text
  objetivo               String?           @db.Text
  resultado              String?           @db.Text
  proxima_actividad      String?           @db.VarChar(200)
  activo                 Boolean           @default(true)
  created_at             DateTime          @default(now()) @db.DateTime(3)
  updated_at             DateTime          @updatedAt @db.DateTime(3)
  created_by             String?           @db.VarChar(36)
  updated_by             String?           @db.VarChar(36)
  cultivo_id             Int

  cultivo    cultivo                  @relation(fields: [cultivo_id], references: [id])
  insumos    Insumo_has_actividades[]
  mano_obra  Mano_de_obra_has_actividades[]
  maquinaria Maquinaria_has_actividades[]
}

model Insumo {
  id             String   @id @default(uuid()) @db.VarChar(36)
  producto       String   @db.VarChar(150)
  categoria      String?  @db.VarChar(100)
  fabricante     String?  @db.VarChar(150)
  cantidad       Decimal? @db.Decimal(10, 2)
  unidad         String?  @db.VarChar(20)
  lote           String?  @db.VarChar(100)
  costo_unitario Decimal? @db.Decimal(10, 2)
  costo_total    Decimal? @db.Decimal(10, 2)
  observaciones  String?  @db.Text
  created_at     DateTime @default(now()) @db.DateTime(3)
  updated_at     DateTime @updatedAt @db.DateTime(3)

  actividades Insumo_has_actividades[]
}

model Mano_de_obra {
  id            String   @id @default(uuid()) @db.VarChar(36)
  trabajador    String   @db.VarChar(150)
  funcion       String?  @db.VarChar(100)
  jornales      Decimal? @db.Decimal(5, 2)
  horas         Decimal? @db.Decimal(5, 2)
  observaciones String?  @db.Text
  created_at    DateTime @default(now()) @db.DateTime(3)
  updated_at    DateTime @updatedAt @db.DateTime(3)

  actividades Mano_de_obra_has_actividades[]
}

model Maquinaria {
  id            String   @id @default(uuid()) @db.VarChar(36)
  equipo        String   @db.VarChar(150)
  operador      String?  @db.VarChar(150)
  horas_uso     Decimal? @db.Decimal(5, 2)
  combustible   Decimal? @db.Decimal(10, 2)
  observaciones String?  @db.Text
  created_at    DateTime @default(now()) @db.DateTime(3)
  updated_at    DateTime @updatedAt @db.DateTime(3)

  actividades Maquinaria_has_actividades[]
}

model Insumo_has_actividades {
  insumo_id      String @db.VarChar(36)
  actividades_id Int

  insumo      Insumo      @relation(fields: [insumo_id], references: [id])
  actividades actividades @relation(fields: [actividades_id], references: [id])

  @@id([insumo_id, actividades_id])
}

model Mano_de_obra_has_actividades {
  mano_de_obra_id String @db.VarChar(36)
  actividades_id Int

  mano_de_obra Mano_de_obra  @relation(fields: [mano_de_obra_id], references: [id])
  actividades actividades @relation(fields: [actividades_id], references: [id])

  @@id([mano_de_obra_id, actividades_id])
}

model Maquinaria_has_actividades {
  maquinaria_id  String @db.VarChar(36)
  actividades_id Int

  maquinaria  Maquinaria    @relation(fields: [maquinaria_id], references: [id])
  actividades actividades @relation(fields: [actividades_id], references: [id])

  @@id([maquinaria_id, actividades_id])
}

model acopio {
  id                    Int            @id @default(autoincrement())
  codigo                String         @unique @db.VarChar(20)
  fecha                 DateTime       @db.DateTime(3)
  acopiador             String         @db.VarChar(150)
  vehiculo              String?        @db.VarChar(100)
  ruta_acopio           String?        @db.VarChar(200)
  total_sacos           Int            @default(0)
  peso_total            Decimal        @default(0) @db.Decimal(10, 2)
  estado                EstadoAcopio   @default(EN_PROCESO)
  observaciones         String?        @db.Text
  activo                Boolean        @default(true)
  created_at            DateTime       @default(now()) @db.DateTime(3)
  updated_at            DateTime       @updatedAt @db.DateTime(3)
  created_by            String?        @db.VarChar(36)
  updated_by            String?        @db.VarChar(36)

  detalles    acopio_detalle[]
  recepciones recepcion[]
}

model acopio_detalle {
  id              Int      @id @default(autoincrement())
  acopio_id       Int
  productor_id    Int
  cultivo_id      Int
  total_sacos     Int      @default(0)
  peso_total      Decimal  @default(0) @db.Decimal(10, 2)
  observaciones   String?  @db.Text
  created_at      DateTime @default(now()) @db.DateTime(3)
  updated_at      DateTime @updatedAt @db.DateTime(3)

  acopio    acopio    @relation(fields: [acopio_id], references: [id])
  productor Productor @relation(fields: [productor_id], references: [id])
  cultivo   cultivo   @relation(fields: [cultivo_id], references: [id])
  sacos     Saco[]

  @@index([acopio_id])
  @@index([productor_id])
  @@index([cultivo_id])
}

model Saco {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  codigo               String   @db.VarChar(50)
  peso                 Decimal  @db.Decimal(10, 2)
  observaciones        String?  @db.Text
  created_at           DateTime @default(now()) @db.DateTime(3)
  updated_at           DateTime @updatedAt @db.DateTime(3)
  acopio_detalle_id    Int

  acopio_detalle acopio_detalle @relation(fields: [acopio_detalle_id], references: [id])

  @@index([acopio_detalle_id])
}

model recepcion {
  id                    Int               @id @default(autoincrement())
  codigo                String            @unique @db.VarChar(20)
  lote_productor        String?           @db.VarChar(100)
  fecha                 DateTime          @db.DateTime(3)
  responsable           String            @db.VarChar(150)
  planta                String            @db.VarChar(100)
  sacos                 Int               @default(0)
  peso_campo            Decimal?          @db.Decimal(10, 2)
  peso_bruto            Decimal?          @db.Decimal(10, 2)
  tara                  Decimal?          @db.Decimal(10, 2)
  peso_neto             Decimal?          @db.Decimal(10, 2)
  diferencia            Decimal?          @db.Decimal(10, 2)
  merma                 Decimal?          @db.Decimal(5, 2)
  humedad               Decimal?          @db.Decimal(5, 2)
  impurezas             Decimal?          @db.Decimal(5, 2)
  materia_extrana       Decimal?          @db.Decimal(5, 2)
  color                 String?           @db.VarChar(50)
  olor                  String?           @db.VarChar(50)
  presencia_insectos    String?           @db.VarChar(50)
  estado_producto       EstadoProducto?
  categoria             CategoriaRecepcion?
  destino               DestinoRecepcion?
  resultado             ResultadoRecepcion?
  motivo                String?           @db.Text
  estado                EstadoRecepcion   @default(PENDIENTE_PESAJE)
  observaciones         String?           @db.Text
  documento_firmado     Boolean           @default(false)
  firma_responsable_url String?           @db.VarChar(500)
  activo                Boolean           @default(true)
  created_at            DateTime          @default(now()) @db.DateTime(3)
  updated_at            DateTime          @updatedAt @db.DateTime(3)
  created_by            String?           @db.VarChar(36)
  updated_by            String?           @db.VarChar(36)
  acopio_id             Int?

  acopio acopio? @relation(fields: [acopio_id], references: [id])
  sacos_detalle recepcion_saco[]
}

model recepcion_saco {
  id             Int      @id @default(autoincrement())
  recepcion_id   Int
  codigo         String   @db.VarChar(50)
  peso           Decimal  @db.Decimal(10, 2)
  observaciones  String?  @db.Text
  created_at     DateTime @default(now()) @db.DateTime(3)

  recepcion recepcion @relation(fields: [recepcion_id], references: [id], onDelete: Cascade)

  @@index([recepcion_id])
}

model Inspecciones {
  id                        Int                  @id @default(autoincrement())
  codigo                    String               @unique @db.VarChar(20)
  fecha                     DateTime             @db.DateTime(3)
  inspector                 String               @db.VarChar(150)
  estado                    EstadoInspeccion     @default(PENDIENTE)
  resultado                 ResultadoInspeccion?
  latitud                   String?              @db.VarChar(30)
  longitud                  String?              @db.VarChar(30)
  altitud                   String?              @db.VarChar(50)
  precision_gps             String?              @db.VarChar(20)
  observaciones             String?              @db.Text
  comentarios_productor     String?              @db.Text
  recomendaciones           String?              @db.Text
  prioridad_recomendacion   String?              @db.VarChar(150)
  responsable_recomendacion String?              @db.VarChar(150)
  fecha_recomendacion       DateTime?            @db.DateTime(3)
  riesgo_general            RiesgoNivel?         @default(BAJO)
  resumen_ejecutivo         String?              @db.Text
  fecha_proxima_inspeccion  DateTime?            @db.DateTime(3)
  nivel_cumplimiento        String?              @db.VarChar(50)
  activo                    Boolean              @default(true)
  created_at                DateTime             @default(now()) @db.DateTime(3)
  updated_at                DateTime             @updatedAt @db.DateTime(3)
  created_by                String?              @db.VarChar(36)
  updated_by                String?              @db.VarChar(36)
  cultivo_id                Int

  cultivo          cultivo               @relation(fields: [cultivo_id], references: [id])
  checklist        inspeccion_checklist[]
  no_conformidades No_conformidades[]
  evidencias       Evidencia[]
}

model inspeccion_checklist {
  id            Int                   @id @default(autoincrement())
  criterio      String                @db.VarChar(200)
  cumplimiento  CumplimientoCriterio?
  riesgo        RiesgoNivel           @default(BAJO)
  observacion   String?               @db.Text
  evidencia     String?               @db.VarChar(500)
  created_at    DateTime              @default(now()) @db.DateTime(3)
  updated_at    DateTime              @updatedAt @db.DateTime(3)
  inspeccion_id Int

  inspeccion Inspecciones @relation(fields: [inspeccion_id], references: [id])
}

model No_conformidades {
  id                Int                    @id @default(autoincrement())
  codigo            String                 @db.VarChar(20)
  tipo              String                 @db.VarChar(100)
  categoria         String                 @db.VarChar(100)
  descripcion       String                 @db.Text
  severidad         SeveridadNoConformidad @default(LEVE)
  responsable       String                 @db.VarChar(150)
  fecha_compromiso  DateTime?              @db.DateTime(3)
  estado            EstadoNoConformidad    @default(PENDIENTE)
  accion_correctiva String?                @db.Text
  created_at        DateTime               @default(now()) @db.DateTime(3)
  updated_at        DateTime               @updatedAt @db.DateTime(3)
  inspeccion_id     Int

  inspeccion Inspecciones        @relation(fields: [inspeccion_id], references: [id])
  acciones   Acciones_correctivas[]
}

model Acciones_correctivas {
  id                Int                    @id @default(autoincrement())
  accion            String                 @db.Text
  responsable       String                 @db.VarChar(150)
  fecha_inicio      DateTime?              @db.DateTime(3)
  fecha_limite      DateTime?              @db.DateTime(3)
  estado            EstadoAccionCorrectiva @default(PENDIENTE)
  observaciones     String?                @db.Text
  created_at        DateTime               @default(now()) @db.DateTime(3)
  updated_at        DateTime               @updatedAt @db.DateTime(3)
  no_conformidad_id Int

  no_conformidad No_conformidades @relation(fields: [no_conformidad_id], references: [id])
}

model Evidencia {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(255)
  descripcion   String?   @db.VarChar(500)
  tipo          String?   @db.VarChar(100)
  ruta_archivo  String?   @db.VarChar(500)
  fecha         DateTime? @db.DateTime(3)
  responsable   String?   @db.VarChar(150)
  created_at    DateTime  @default(now()) @db.DateTime(3)
  updated_at    DateTime  @updatedAt @db.DateTime(3)
  inspeccion_id Int

  inspeccion Inspecciones @relation(fields: [inspeccion_id], references: [id])
}

model procesamiento {
  id                  Int                  @id @default(autoincrement())
  codigo              String               @unique @db.VarChar(20)
  fecha_fin           DateTime             @db.DateTime(3)
  fecha_inicio        DateTime             @db.DateTime(3)
  producto            String               @db.VarChar(100)
  responsable         String               @db.VarChar(150)
  planta              String               @db.VarChar(100)
  linea_procesamiento LineaProcesamiento
  estado              EstadoProcesamiento  @default(REGISTRADA)
  observaciones       String?              @db.Text
  peso_entrada        Decimal?             @db.Decimal(10, 2)
  peso_salida         Decimal?             @db.Decimal(10, 2)
  merma               Decimal?             @db.Decimal(10, 2)
  rendimiento         Decimal?             @db.Decimal(5, 2)
  producto_base       String?              @db.VarChar(100)
  calidad_producto    CalidadProducto?
  peso_final          Decimal?             @db.Decimal(10, 2)
  humedad_final       Decimal?             @db.Decimal(5, 2)
  activo              Boolean              @default(true)
  created_at          DateTime             @default(now()) @db.DateTime(3)
  updated_at          DateTime             @updatedAt @db.DateTime(3)
  created_by          String?              @db.VarChar(36)
  updated_by          String?              @db.VarChar(36)
}

model kardex {
  id                Int             @id @default(autoincrement())
  codigo            String          @unique @db.VarChar(20)
  producto          String          @db.VarChar(200)
  categoria         String          @db.VarChar(100)
  unidad            String          @default("kg") @db.VarChar(10)
  cantidad_actual   Decimal         @default(0) @db.Decimal(10, 2)
  cantidad_minima   Decimal?        @db.Decimal(10, 2)
  cantidad_maxima   Decimal?        @db.Decimal(10, 2)
  ubicacion         String?         @db.VarChar(200)
  estado            EstadoKardex    @default(DISPONIBLE)
  fecha_ingreso     DateTime        @db.DateTime(3)
  fecha_vencimiento DateTime?       @db.DateTime(3)
  proveedor         String?         @db.VarChar(200)
  costo_unitario    Decimal?        @db.Decimal(10, 2)
  observaciones     String?         @db.Text
  activo            Boolean         @default(true)
  created_at        DateTime        @default(now()) @db.DateTime(3)
  updated_at        DateTime        @updatedAt @db.DateTime(3)
  created_by        String?         @db.VarChar(36)
  updated_by        String?         @db.VarChar(36)

  movimientos kardex_movimiento[]
}

model kardex_movimiento {
  id                Int           @id @default(autoincrement())
  tipo              TipoMovimiento
  cantidad          Decimal       @db.Decimal(10, 2)
  saldo_anterior    Decimal       @db.Decimal(10, 2)
  saldo_posterior   Decimal       @db.Decimal(10, 2)
  destino           String?       @db.VarChar(200)
  referencia        String?       @db.VarChar(200)
  responsable       String?       @db.VarChar(150)
  observaciones     String?       @db.Text
  fecha             DateTime      @default(now()) @db.DateTime(3)
  created_at        DateTime      @default(now()) @db.DateTime(3)
  kardex_id         Int

  kardex kardex @relation(fields: [kardex_id], references: [id])
}

model catalogos {
  id          Int      @id @default(autoincrement())
  tipo        String   @db.VarChar(50)
  nombre      String   @db.VarChar(500)
  descripcion String?  @db.VarChar(500)
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  created_by  String?  @db.VarChar(36)
  created_at  DateTime @default(now()) @db.DateTime(3)
  updated_at  DateTime @updatedAt @db.DateTime(3)
  updated_by  String?  @db.VarChar(36)

  @@unique([tipo, nombre])
  @@index([tipo])
}

model ubigeo {
  id       Int    @id @default(autoincrement())
  ubigeo   String @unique @db.Char(6)
  dpto     String @db.VarChar(32)
  prov     String @db.VarChar(32)
  distrito String @db.VarChar(32)

  @@index([dpto])
  @@index([prov])
  @@index([distrito])
}

model usuarios {
  id         String   @id @default(uuid()) @db.VarChar(36)
  nombre     String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  rol        Rol      @default(USER)
  activo     Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(3)
  updated_at DateTime @updatedAt @db.DateTime(3)
  rol_sic    RolSic?
}
