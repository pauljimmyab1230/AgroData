# AgroData API — variables de entorno
# Copia este archivo como .env y rellena los valores reales.

PORT=5000
NODE_ENV=development

# Conexión a MySQL. En producción usar un usuario SIN privilegios de root.
DATABASE_URL="mysql://usuario:password@localhost:3306/agrodata"

# Secreto JWT: mínimo 32 caracteres. Genera uno con:
#   openssl rand -base64 48
# Rotar este valor invalida todos los tokens emitidos.
JWT_SECRET="cambia-este-secreto-por-uno-aleatorio-de-32-o-mas-caracteres"
JWT_EXPIRES_IN="15m"

# Orígenes permitidos por CORS (separados por coma en FRONTEND_URLS)
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS=""
